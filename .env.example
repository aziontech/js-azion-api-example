# ===========================================
# Example API - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# -------------------------------------------
# SSO Authentication (Azion)
# -------------------------------------------
# Environment mode: development | stage | production
SSO_MODE=stage

# GraphQL secret for SSO communication
SSO_GQL_SECRET=

# Optional: Public key for JWT validation (if not using GraphQL)
# PUBLIC_JWT_ACCESS_TOKEN_KEY=

# -------------------------------------------
# AWS RDS Data API
# -------------------------------------------
# AWS Region where your RDS cluster is located
RDS_REGION=us-east-1

# ARN of your Aurora Serverless cluster
# Example: arn:aws:rds:us-east-1:123456789012:cluster:my-cluster
RDS_RESOURCE_ARN=

# ARN of the secret in AWS Secrets Manager containing DB credentials
# Example: arn:aws:secretsmanager:us-east-1:123456789012:secret:my-secret-abc123
RDS_SECRET_ARN=

# Database name
RDS_DATABASE=

# Optional: AWS credentials (if not using IAM role or environment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -------------------------------------------
# Server Configuration
# -------------------------------------------
# Port for local development server
PORT=3000
